{
  "name": "temporal-money-transfer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bench:client": "tsx src/bench/client.ts",
    "bench:compare": "tsx src/bench/compare.ts",
    "bench:worker": "tsx src/bench/worker.ts",
    "build": "npm run clean && tsc --build",
    "build.watch": "tsc --build --watch",
    "client": "tsx src/client.ts",
    "clean": "node --eval \"const fs = require('node:fs'); fs.rmSync('lib', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true });\"",
    "format": "prettier --write .",
    "lint": "eslint src test",
    "test": "tsx --test test/*.test.ts",
    "worker": "tsx src/worker.ts",
    "worker.watch": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.15.0",
    "@temporalio/client": "^1.15.0",
    "@temporalio/common": "^1.15.0",
    "@temporalio/worker": "^1.15.0",
    "@temporalio/workflow": "^1.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@temporalio/testing": "^1.15.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
